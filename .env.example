# Node.js environment
NODE_ENV=development

# Application
APP_NAME=Nintendo Switch Games Monitor
LOG_LEVEL=info

# SMTP (Gmail) — used in v0.2
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_TO=your-email@gmail.com

# Email provider selection: 'gmail' (real) or 'mock' (local testing, no credentials)
EMAIL_PROVIDER=gmail
# Directory where mock provider saves rendered emails (default: data/emails)
MOCK_EMAIL_OUT_DIR=data/emails

# Game collector selection: 'mock' (sample data, default) or 'deku' (real deals feed)
GAME_COLLECTOR=mock
# Deals source: public Nintendo eShop JSON feed (Solr). Override to use another source.
DEALS_SOURCE_URL=https://searching.nintendo-europe.com/en/select?fq=type:GAME&fq=playable_on_txt:HAC&fq=price_has_discount_b:true&q=*&wt=json
# Currency reported by the deals source (default: EUR)
DEALS_CURRENCY=EUR
# How many deals to fetch per run for the deku collector (default: 100)
DEALS_LIMIT=100

# Monitor pipeline
# Notification preferences — overrides data/settings.json (see README "Configuration")
# Minimum deal score for a game to be included in the report (default: 80)
MIN_DEAL_SCORE=80
# Notification history
# How long to wait before notifying about the same game at the same price again (default: 14)
NOTIFICATION_COOLDOWN_DAYS=14
# How many games to include per email (default: 10)
MAX_GAMES_PER_EMAIL=10
# Whether to report free games (default: true)
NOTIFY_FREE_GAMES=true
# Whether to report wishlist matches (default: true)
NOTIFY_WISHLIST_MATCHES=true
