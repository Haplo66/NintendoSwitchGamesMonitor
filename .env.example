# Node.js environment (optional)
NODE_ENV=development

# Secrets only — everything else is configured in data/settings.json
# (user preferences) or inside the provider/collector implementations.
#
# .env is git-ignored. Never commit real credentials.

# SMTP (Gmail) — used by the gmail email provider. The Gmail SMTP host/port
# are built into the provider, and the "From" address is always SMTP_USER.
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
