# Node.js environment
NODE_ENV=development

# This local .env mirrors the values used by the scheduled GitHub Actions workflow
# (monitor.yml), which runs once per day at 06:30 UTC. In CI the values below are
# provided as repository secrets (Settings > Secrets and variables > Actions) and
# any scheduled step failure appears in the GitHub Actions run logs.
#
# User preferences (platform, email provider, dry/force run, log level) do NOT
# belong here. Configure them in data/settings.json and set an environment
# variable only to override it for CI or a temporary run.

# Application
APP_NAME=Nintendo Switch Games Monitor

# SMTP (Gmail) — used in v0.2
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_TO=your-email@gmail.com

# Directory where mock provider saves rendered emails (default: data/emails)
MOCK_EMAIL_OUT_DIR=data/emails

# Game collector selection: 'mock' (sample data, default) or 'nintendo' (Nintendo price API)
GAME_COLLECTOR=mock
# Nintendo eShop region (US only): 'US' (default)
NINTENDO_REGION=US
# Game catalog (JSON array) watched by the 'nintendo' collector (default: data/game-catalog.json)
GAME_CATALOG=data/game-catalog.json
# Currency reported by the price API (default: USD)
DEALS_CURRENCY=USD
# How many games to fetch per run for the 'nintendo' collector (default: 100)
DEALS_LIMIT=100

# Monitor pipeline
# Notification preferences — overrides data/settings.json (see README "Configuration")
# Minimum deal score for a game to be included in the report (default: 80)
MIN_DEAL_SCORE=80
# Notification history
# How long to wait before notifying about the same game at the same price again (default: 14)
NOTIFICATION_COOLDOWN_DAYS=14
# How many games to include per email (default: 10)
MAX_GAMES_PER_EMAIL=10
# Whether to report free games (default: true)
NOTIFY_FREE_GAMES=true
# Whether to report wishlist matches (default: true)
NOTIFY_WISHLIST_MATCHES=true
# Discount percent used to compute an automatic target price when a wishlist item has no targetPrice (default: 40)
DEFAULT_WISHLIST_DISCOUNT_PERCENT=40
# Whether wishlist items without an explicit targetPrice notify on any discount (default: false)
DEFAULT_NOTIFY_ON_ANY_DISCOUNT=false
# Test mode: when true, bypass cooldown filtering and never write to notification history (default: false)
IGNORE_NOTIFICATION_HISTORY=false
