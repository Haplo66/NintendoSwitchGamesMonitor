{
  "name": "nintendo-switch-games-monitor",
  "version": "0.1.0",
  "description": "Monitors Nintendo Switch game deals, analyzes them, and notifies via HTML email. Built with Node.js + TypeScript.",
  "private": true,
  "main": "dist/main.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/main.js",
    "dev": "ts-node src/main.ts",
    "test-email": "npm run build && node dist/notifications/test-email.js",
    "validate-email": "npm run build && node dist/notifications/email-validation.js",
    "collect-games": "npm run build && node dist/collectors/collect-games.js",
    "generate-catalog": "npm run build && node dist/collectors/generate-catalog.js",
    "validate-config": "npm run build && node dist/config/validate-config.js",
    "validate-settings": "npm run build && node dist/config/validate-settings.js",
    "validate-preferences": "npm run build && node dist/config/validate-preferences.js",
    "validate-history": "npm run build && node dist/config/validate-history.js",
    "analyze-games": "npm run build && node dist/analyzer/analyze-games.js",
    "validate-analyzer": "npm run build && node dist/analyzer/validate-analyzer.js",
    "validate-collector": "npm run build && node dist/collectors/validate-collector.js",
    "monitor": "npm run build && node dist/pipeline/monitor-run.js",
    "monitor:dry": "npm run build && node dist/scripts/run-monitor.js dry",
    "monitor:test-email": "npm run build && node dist/scripts/run-monitor.js test-email",
    "validate-dry-run": "npm run build && node dist/pipeline/validate-dry-run.js",
    "validate-force-email": "npm run build && node dist/pipeline/validate-force-email.js",
    "report": "npm run build && node dist/reports/generate-report.js",
    "validate-reports": "npm run build && node dist/reports/validate-reports.js",
    "validate-wishlist-price": "npm run build && node dist/notifications/validate-wishlist-price.js",
    "validate-blacklist": "npm run build && node dist/pipeline/validate-blacklist.js",
    "validate-recommendations": "npm run build && node dist/notifications/validate-recommendations.js",
    "validate-production": "npm run build && node dist/config/validate-production.js",
    "test": "npm run build && npm run validate-analyzer && npm run validate-collector && npm run validate-config && npm run validate-settings && npm run validate-preferences && npm run validate-history && npm run validate-dry-run && npm run validate-force-email && npm run validate-reports && npm run validate-email && npm run validate-wishlist-price && npm run validate-blacklist && npm run validate-recommendations && npm run validate-production"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/nodemailer": "^8.0.1",
    "dotenv": "^16.4.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  },
  "dependencies": {
    "nodemailer": "^9.0.3"
  }
}
